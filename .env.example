# ============================================
# Dots Frontend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables prefixed with EXPO_PUBLIC_ are accessible in the app
# via process.env.EXPO_PUBLIC_VARIABLE_NAME
# ============================================

# ---- Backend API ----
# The URL of your Dots backend server.
# Example: https://your-app.up.railway.app or http://localhost:5000
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# ---- TalkJS (Real-Time Chat) ----
# Sign up at https://talkjs.com to get your App ID and Secret Key.
# The App ID is found in the TalkJS Dashboard under Settings.
# The Secret Key is found in the TalkJS Dashboard under Settings > Keys.
EXPO_PUBLIC_TALKJS_APP_ID=your_talkjs_app_id
EXPO_PUBLIC_TALKJS_SECRET_KEY=your_talkjs_secret_key
